#!/bin/sh
set -e

if [ "$1" = remove ]; then
    deb-systemd-helper disable blueroute.service >/dev/null || true
fi

# Durable identity and membership under /var/lib/blueroute are deliberately
# retained on remove. Debian's purge operation is the explicit data deletion.
# Purge always follows a successful `prerm remove` (directly, or on a package
# already removed), so the networking cleanup has succeeded before this
# evidence is deleted (CR-F5).
if [ "$1" = purge ]; then
    rm -rf "${DPKG_ROOT:-}/var/lib/blueroute"
fi

#DEBHELPER#

exit 0
